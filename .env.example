QI_DATABASE_URL=mysql://qiandao:change-me@127.0.0.1:3306/qiandao
QI_ORIGIN=http://127.0.0.1:3086
# Generate separate keys with node -p "require('node:crypto').randomBytes(32).toString('hex')"
QI_SIGNING_KEY=
QI_DATA_KEY=
# Optional. Set only behind a reverse proxy that replaces X-Forwarded-For.
QI_TRUST_PROXY=0

# Client account email verification. Use 465 for implicit TLS or 587 for STARTTLS.
QI_SMTP_HOST=
QI_SMTP_PORT=587
QI_SMTP_USER=
QI_SMTP_PASSWORD=
QI_SMTP_FROM=

# Select one SMS provider for this installation: tencent or aliyun.
QI_SMS_PROVIDER=
QI_TENCENT_SECRET_ID=
QI_TENCENT_SECRET_KEY=
QI_TENCENT_SMS_REGION=ap-guangzhou
QI_TENCENT_SMS_APP_ID=
QI_TENCENT_SMS_SIGN=
QI_TENCENT_SMS_TEMPLATE=
QI_ALIYUN_ACCESS_KEY_ID=
QI_ALIYUN_ACCESS_KEY_SECRET=
QI_ALIYUN_SMS_SIGN=
QI_ALIYUN_SMS_TEMPLATE=

# WeChat Open Platform website application. Use an HTTPS QI_ORIGIN.
QI_WECHAT_APP_ID=
QI_WECHAT_APP_SECRET=
